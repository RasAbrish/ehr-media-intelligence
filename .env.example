# Copy to .env and adjust. Every variable the app reads is listed here.
# Values are unquoted; text after " #" is a comment.

# --- LLM ---
# empty → extractive fallback (keep comments off blank values: compose reads them as the value)
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto             # auto | anthropic | groq | extractive (auto: Claude, then Groq, by key)
LLM_MODEL=claude-haiku-5-5    # any current Claude model id
# Free alternative (ADR-014). Keep it local; the demo ships the summaries it makes.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b  # a Groq model with JSON schema output
LLM_MAX_CONCURRENCY=4         # parallel summary requests
LLM_TIMEOUT_S=30              # per request timeout in seconds
SUMMARY_MAX_WORDS=200         # hard word limit for summaries
PROMPT_VERSION=v1             # folder under summarization/prompts/
LLM_DAILY_TOKEN_BUDGET=500000 # tokens per day before the budget guard trips

# --- Paths (relative to the repo root) ---
DATA_RAW_DIR=data/raw         # synthetic raw exports
DATA_DIR=data/generated       # all generated state (gitignored)
SQLITE_PATH=data/generated/ehr_mip.db       # clean data, bundles, audit, summary cache
CHROMA_DIR=data/generated/chroma           # vector index (embedded Chroma)
HF_HOME=data/generated/hf-cache            # embedding model download cache
REPORTS_DIR=reports                        # validation and eval reports

# --- Search ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # local CPU embedder
SEARCH_DEFAULT_TOP_K=5        # results per search (max 20)
SEARCH_MODE=hybrid            # semantic | hybrid (meaning + keywords)
INDEX_OBSERVATIONS=false      # index individual lab Observations
SEARCH_CACHE_TTL_S=60         # search response cache lifetime

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # comma separated allowlist
ENABLE_ADMIN_ENDPOINTS=false  # admin routes off by default (P2)
# required when ENABLE_ADMIN_ENDPOINTS=true
ADMIN_TOKEN=
AUTO_BOOTSTRAP=false          # run the pipeline on API start if the DB is empty
RATE_LIMIT_ENABLED=true       # per-IP limits with RateLimit-* headers
FORWARDED_ALLOW_IPS=127.0.0.1 # proxies trusted for X-Forwarded-For (add the nginx container IP in docker)
FEEDBACK_ENABLED=true         # allow helpful / not helpful summary feedback
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
ENV=dev                       # dev | prod (prod disables /docs and enables HSTS)
# true or false; empty: /docs on in dev, off in prod
API_DOCS_ENABLED=

# --- Sign-in (ADR-013) ---
AUTH_ENABLED=true             # false only for local tools; every data route then answers without a session
SESSION_HOURS=8               # a session ends this long after sign-in
SESSION_IDLE_MINUTES=60       # or after this long without a request
# An account created at startup when both are set. On Render, enter them as secret settings
SEED_ACCOUNT_EMAIL=
SEED_ACCOUNT_PASSWORD=
SEED_ACCOUNT_NAME=Clinician   # name shown in the app for that account

# --- Cache ---
CACHE_BACKEND=memory          # memory | redis | auto (redis while one answers; compose uses auto)
REDIS_URL=redis://redis:6379/0   # used only when CACHE_BACKEND=redis

# --- Synthetic data ---
SYNTH_SEED=42                 # generator seed (same seed, same bytes)
SYNTH_PATIENTS=60             # synthetic patients to generate (min 14)

# Docker Compose only (compose sets paths, AUTO_BOOTSTRAP and CACHE_BACKEND itself):
# WEB_BIND=127.0.0.1                       # host address for the web port; the app has no login
# WEB_PORT=8080                            # host port of the web app

# Frontend tooling only (read from the shell, not by the API):
# VITE_DEMO_MODE=true                    # build with the public demo banner (render.yaml sets it)
# API_PROXY_TARGET=http://localhost:8000   # where the Vite dev server proxies /api
# E2E_BASE_URL=http://localhost:8080       # run the e2e tests against a running stack
# LIGHTHOUSE_BASE_URL=http://localhost:8080  # audit a running stack with `make lighthouse`
# LIGHTHOUSE_CHROME_FLAGS=--headless=new  # Chrome flags for `make lighthouse` (CI adds --no-sandbox)
